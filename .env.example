# Copy to .env or let ./rag up generate it (secrets are generated, never committed).
POSTGRES_DB=ragsearch
POSTGRES_USER=ragsearch
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ragsearch:change-me@postgres:5432/ragsearch
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-on-first-run

# Only used by the optional SearXNG container (./rag up with COMPOSE_PROFILES=websearch); generated by ./rag up.
SEARXNG_SECRET=

# Host ports (./rag up picks the next free port if one is busy and writes the choice here).
WEB_PORT=5173
API_PORT=8000
PG_PORT=5433
QDRANT_PORT=6335
REDIS_PORT=6380

# Jev: fast typed decisions only (one plan call, candidate rerank, per-sentence grounding). Optional; search works without it.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_MS=900
# Blank = on whenever a Jev key is set; true/false forces it. Jev reranks the top JEV_RERANK_TOP_N candidates.
JEV_RERANK_ENABLED=
# Candidates considered for Jev rerank (one batched Noul request: JEV_BATCH_SIZE tracks this value so top-N stays a single Jev
# call). Raised from the old 12 default as a TARGET fix for "local fusion loses semantic matches" (docs/KNOWN_ISSUES.md) --
# NOT yet benchmarked against the old default; re-measure with scripts/evaluate.py before relying on this number. The
# per-candidate (noul_parallel) and sync (score_batch) rerank styles were removed from the request path (they collapsed under
# concurrency / blocked a shared thread pool) and are no longer settable here.
JEV_RERANK_TOP_N=20
# Jev client: connection pool (>=128 recommended), candidates per request, blend weights 'noul,first_stage,prior' (tuned on the benchmark dev split; see docs).
JEV_POOL_MAX=128
JEV_BATCH_SIZE=20
JEV_BATCH_CHARS=4500
RERANK_BLEND=
JEV_CHUNK_PROFILE_ENABLED=false
RRF_WEIGHTS=bm25=1,dense=1,fts=0.6
# How the two lexical legs (bm25, fts) combine in RRF: 'max' (default) takes the better of the two per candidate instead of
# summing them. BM25 and Postgres FTS are both lexical signals over the same text and highly correlated, so summing them
# effectively gives lexical evidence ~1.6x the votes of a dense-only (semantic/paraphrase) match -- 'sum' restores that.
RRF_LEXICAL=max
# Dense leg: neighbours below DENSE_MIN_SCORE are dropped; with no lexical hit the best neighbour must reach DENSE_ALONE_MIN or the search returns no results. (calibrated on the benchmark, see docs)
# DENSE_TOP_K matches the lexical legs' depth (60): an asymmetric pool size hands extra low-rank RRF credit to whichever leg is deeper.
DENSE_TOP_K=60
DENSE_MIN_SCORE=0.25
DENSE_ALONE_MIN=0.33
# Local on-box fallback reranker (sentence-transformers CrossEncoder, no external call): used whenever Jev is off (local-only
# mode, no Jev key configured, or an admin per-request override) and a request still wants reranking. On by default since it
# is the only reranking those searches would otherwise get; set to false to skip loading/warming the model entirely.
LOCAL_RERANKER_ENABLED=true
LOCAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# cpu is the default: for this small model on a Mac, 'mps' measured 30-100 ms per query (erratic, ~3 s first-batch setup) versus ~8 ms on cpu.
EMBEDDING_DEVICE=cpu

# AI Overview (off by default for every user; written only after results are shown, only for questions of more than 3 words).
# OVERVIEW_LLM_* fall back to LLM_*. A fast non-reasoning model is recommended; set OVERVIEW_EXTRA_BODY to a JSON object your provider
# needs to disable reasoning (provider specific, for example {"chat_template_kwargs":{"enable_thinking":false}}).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_BUDGET_TOKENS=2800
OVERVIEW_LLM_BASE_URL=
OVERVIEW_LLM_MODEL=
OVERVIEW_LLM_API_KEY=
OVERVIEW_MAX_TOKENS=350
OVERVIEW_TIMEOUT_S=12
# attempt 1 is capped at OVERVIEW_ATTEMPT_S so a stuck call leaves room for one retry (timeout/429/5xx) inside the total OVERVIEW_TIMEOUT_S
OVERVIEW_ATTEMPT_S=7
# overviews generating at once per API process; more are withheld with reason 'busy' (search is never affected)
OVERVIEW_MAX_CONCURRENT=8
# per-claim grounding threshold (calibrated; see docs). A failing bullet is dropped; a failing lead sentence withholds the overview.
OVERVIEW_GROUNDED_MIN=0.6
OVERVIEW_EXTRA_BODY=

# Quick answer: the DEFAULT search mode (no retrieval, no Jev, no web -- just a direct streamed LLM chat). NOT private: query+history go
# to whichever provider resolves below. Falls back DIRECT_LLM_* -> OVERVIEW_LLM_* -> LLM_* (base/key/model taken together from one tier,
# so a key is never paired with a different provider's host). A fast NON-REASONING model keeps time-to-first-token low; use
# DIRECT_EXTRA_BODY for a provider's "disable reasoning" switch, and for a local Ollama/vLLM server {"keep_alive":"30m"} avoids reloading
# weights between requests. Quick answer is unavailable (UI falls back to Search) until one of these tiers has both a base URL and model.
DIRECT_LLM_BASE_URL=
DIRECT_LLM_MODEL=
DIRECT_LLM_API_KEY=
DIRECT_MAX_TOKENS=700
DIRECT_TEMPERATURE=0.3
DIRECT_EXTRA_BODY=
DIRECT_FIRST_TOKEN_S=8
DIRECT_TOTAL_S=60
DIRECT_MAX_CONCURRENT=32
# Which mode the UI selects by default when neither Local-only nor a saved preference is set: quick (direct LLM) or search (RAG).
DEFAULT_MODE=quick
# When true: /search is forced to local-only (no web, no Jev, no plan/rerank) for every request regardless of client toggles, and
# /search/overview and /answer both return 403. A deployment-wide privacy lock, distinct from the per-request Local KB only toggle.
LOCAL_ONLY_ENFORCED=false

MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173

# Web search is private by default: it runs only when this is true AND the user switches Web on for that search.
# Only the query text leaves the system, to the providers named below (the UI and admin console show the same list).
WEB_SEARCH_ENABLED=false
# Ordered chain. Default is ddgs only (or brave_api,ddgs when BRAVE_API_KEY is set). searxng needs SEARXNG_URL.
WEB_PROVIDERS=
# ddgs engines are pinned (never ddgs "auto", which fans out to Wikipedia plus random engines).
WEB_DDGS_BACKENDS=yahoo,duckduckgo  # 'bing' is not an available engine in the pinned ddgs (it silently ran yahoo alone, and a single throttled engine made Deep Research fail with no_sources); check engines with DDGS().text(q, backend=name)
BRAVE_API_KEY=
SEARXNG_URL=
# Jev rerank of web snippets: OFF by default. On the recorded fixtures no blend beat the BM25+prior first stage (0.912 vs 0.834 at the default weights); true opts in.
WEB_RERANK_ENABLED=false
WEB_TIMEOUT_MS=3000
WEB_HEDGE_MS=700
WEB_CACHE_TTL_S=900
# Start the web fetch in parallel with the Jev plan call (only after the user opted in). false waits for the plan: +~250 ms.
WEB_SPECULATIVE=true
# JSON {"domain": 0..1} to override the built-in domain quality priors.
WEB_DOMAIN_PRIORS=

# Documents stuck in "processing" longer than this are marked failed by the startup sweeper.
STALE_PROCESSING_MINUTES=30

# Provider URLs (Jev, LLM, SearXNG) must be http/https without credentials and not link-local/metadata. Optional allowlist of hosts or .suffixes (comma-separated).
PROVIDER_URL_ALLOWLIST=
LOG_LEVEL=INFO

# Deep Research: query decomposition -> parallel web search per sub-question -> one report-writing LLM call -> citation
# validation -> bounded Jev grounding. NOT private (searches public web sources; disabled entirely when local-only is on
# or WEB_SEARCH_ENABLED=false) and NOT fast (45s-3min; a hard cap, not a target). Off by default -- it costs multiple LLM
# calls and web searches per run. Falls back DEEP_RESEARCH_LLM_* -> OVERVIEW_LLM_* -> LLM_* (same-tier base/key/model).
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_LLM_BASE_URL=
DEEP_RESEARCH_LLM_MODEL=
DEEP_RESEARCH_LLM_API_KEY=
# Requires a Jev key by default (citations are verified against the cited snippets); an admin can relax this, and a
# report then says its citations were not independently verified.
DEEP_RESEARCH_REQUIRE_JEV=true
DEEP_RESEARCH_MAX_SUBQ=5
DEEP_RESEARCH_QUERIES_PER_SUBQ=2
DEEP_RESEARCH_SOURCES_PER_SUBQ=4
DEEP_RESEARCH_MAX_SOURCES=20
DEEP_RESEARCH_SOURCE_CHARS=1800
DEEP_RESEARCH_WEB_PARALLEL=3
DEEP_RESEARCH_QUERY_GAP_MS=250
DEEP_RESEARCH_TOTAL_S=300
DEEP_RESEARCH_PLAN_TIMEOUT_S=30
DEEP_RESEARCH_REPORT_TIMEOUT_S=180
DEEP_RESEARCH_REPORT_MAX_TOKENS=4000
DEEP_RESEARCH_GROUND_MAX=40
DEEP_RESEARCH_GROUNDED_MIN=0.6
# A report whose claims are more than this fraction uncited is rejected outright rather than shown half-broken.
DEEP_RESEARCH_DROP_RATE_MAX=0.3
# Process-wide concurrent runs (not per-user); per-user hourly quota is separate (DEEP_RESEARCH_PER_USER_PER_HOUR).
DEEP_RESEARCH_MAX_CONCURRENT=2
DEEP_RESEARCH_PER_USER_PER_HOUR=10
# Phase B: fetch each source's full page instead of relying on the provider's short snippet (snippets are the main reason
# citations were often flagged as "not verified" in the snippets-only mode) -- off by default since it adds real latency
# and a new outbound-fetch surface (backend/webfetch.py: every resolved IP must be globally routable; private/loopback/
# link-local/metadata addresses are rejected before connecting; DEEP_RESEARCH_FETCH_ALLOWLIST restricts it further).
DEEP_RESEARCH_FETCH_PAGES=false
DEEP_RESEARCH_FETCH_ALLOWLIST=
DEEP_RESEARCH_MAX_PAGES=10
DEEP_RESEARCH_PAGE_MAX_BYTES=1500000
DEEP_RESEARCH_PAGE_TIMEOUT_S=6
DEEP_RESEARCH_PAGE_TEXT_CHARS=2500

# Token cache (backend/tokencache.py, docs/TOKEN_EFFICIENCY.md): sealed cache of plans, routes and web-only reports with single-flight.
TOKENCACHE_ENABLED=true
TOKENCACHE_PLAN_TTL_S=86400
TOKENCACHE_ROUTE_TTL_S=86400
DEEP_RESEARCH_CACHE_TTL_S=1800
# Jev complexity score below this skips the LLM planner (single sub-question); 0 always uses the LLM planner.
DEEP_RESEARCH_ROUTE_SIMPLE_BELOW=0.25
# Extra retry queries (one alternative query each) for sub-questions that found nothing; 0 disables.
DEEP_RESEARCH_REFLECT_MAX=3

# Quick answer cache (off by default; a wrong answer would be frozen for the TTL). Only history-free queries with no time-sensitive or
# personal wording (today/now/latest/price/my/me/I/20xx...) are cached or served from cache. TTL: TOKENCACHE_ANSWER_TTL_S.
DIRECT_CACHE_ENABLED=false

# Deep Research secondary model (Admin > AI configuration > Deep Research): a fast NON-reasoning model used when the primary fails or times out,
# and optionally to write the plan (DEEP_RESEARCH_SECONDARY_ROLE=planner_and_failover). It never inherits the base LLM; blank = off.
DEEP_RESEARCH_2_LLM_BASE_URL=
DEEP_RESEARCH_2_LLM_MODEL=
DEEP_RESEARCH_2_LLM_API_KEY=
DEEP_RESEARCH_SECONDARY_ROLE=failover
# Provider-specific JSON merged into the request body, e.g. to switch a reasoning model's thinking off.
DEEP_RESEARCH_EXTRA_BODY=
DEEP_RESEARCH_2_EXTRA_BODY=
